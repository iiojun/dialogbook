<!-- Translate Guide Button -->
<div class="mb-3">
<button type="button" class="translate-guide-btn" onclick="openTranslateModal()">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
       stroke="currentColor" stroke-width="2">
    <circle cx="12" cy="12" r="10"/>
    <path d="M2 12h20"/>
    <path d="M12 2a15.3 15.3 0 0 1 4 10
             15.3 15.3 0 0 1-4 10
             15.3 15.3 0 0 1-4-10
             15.3 15.3 0 0 1 4-10z"/>
  </svg>
  Translate Page
</button>
</div>

<!-- Modal Overlay -->
<div id="translateModal"
     class="translate-modal-backdrop"
     onclick="closeTranslateModal(event)">
  <div class="translate-modal-content"
       onclick="event.stopPropagation()">
    <button type="button"
            class="translate-modal-close"
            onclick="closeTranslateModal()">&times;</button>
    <div class="translate-modal-header">
      <h2>How to Translate This Page</h2>
      <p>
        Use your browser's built-in translation tool to safely and
        seamlessly view this page in your language.
      </p>
    </div>

    <div class="translate-steps">
      <!-- Chrome -->
      <div class="step-card" id="guide-chrome">
        <div class="browser-badge">Google Chrome</div>
        <ol>
          <li>Click the <strong>Translate Icon</strong> in the address bar (or main menu).</li>
          <li>Select your preferred language.</li>
        </ol>
      </div>
      <!-- Safari -->
      <div class="step-card" id="guide-safari">
        <div class="browser-badge">Safari</div>
        <ol>
          <li>Tap the <strong>"aA"</strong> or <strong>Translate Icon</strong> in the address bar.</li>
          <li>Select <strong>"Translate to [Your Language]"</strong>.</li>
        </ol>
      </div>
      <!-- Edge -->
      <div class="step-card" id="guide-edge">
        <div class="browser-badge">Microsoft Edge</div>
        <ol>
          <li>Click the <strong>Translate Icon</strong> in the address bar.</li>
          <li>Choose your language and click <strong>Translate</strong>.</li>
        </ol>
      </div>
    </div>
  </div>
</div>

<style>
/* =========================================================
   Bootswatch Sandstone-inspired styles
   ========================================================= */

/* Button */
.translate-guide-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;

  padding: 10px 18px;

  font-family: "Open Sans", -apple-system, BlinkMacSystemFont,
               "Segoe UI", sans-serif;
  font-size: 14px;
  font-weight: 600;

  color: #325d88;
  background-color: #f8f5f0;

  border: 1px solid #ced4da;
  border-radius: 4px;

  cursor: pointer;

  transition:
    background-color 0.15s ease,
    border-color 0.15s ease,
    color 0.15s ease,
    box-shadow 0.15s ease;
}

.translate-guide-btn:hover {
  color: #26496b;
  background-color: #e9e5df;
  border-color: #b9c0c7;
}

.translate-guide-btn:focus {
  outline: none;
  box-shadow: 0 0 0 0.2rem rgba(50, 93, 136, 0.2);
}

/* Modal Overlay */
.translate-modal-backdrop {
  display: none;

  position: fixed;
  inset: 0;

  width: 100%;
  height: 100%;

  background-color: rgba(43, 43, 43, 0.45);
  backdrop-filter: blur(2px);

  z-index: 9999;

  align-items: center;
  justify-content: center;

  opacity: 0;

  transition: opacity 0.2s ease;
}

.translate-modal-backdrop.is-active {
  display: flex;
  opacity: 1;
}

/* Modal Card */
.translate-modal-content {
  position: relative;

  width: 90%;
  max-width: 520px;

  padding: 28px;

  font-family: "Open Sans", -apple-system, BlinkMacSystemFont,
               "Segoe UI", sans-serif;

  color: #3d3d3d;
  background: #ffffff;

  border: 1px solid #ced4da;
  border-radius: 5px;

  box-shadow:
    0 8px 24px rgba(0, 0, 0, 0.16);

  transform: translateY(10px);

  transition: transform 0.2s ease;
}

.translate-modal-backdrop.is-active
.translate-modal-content {
  transform: translateY(0);
}

/* Close Button */
.translate-modal-close {
  position: absolute;

  top: 14px;
  right: 16px;

  padding: 0;

  background: transparent;
  border: none;

  font-family: inherit;
  font-size: 26px;
  font-weight: 300;

  line-height: 1;

  color: #777;

  cursor: pointer;
}

.translate-modal-close:hover {
  color: #325d88;
}

/* Header */
.translate-modal-header h2 {
  margin: 0 32px 8px 0;

  font-family: "Open Sans", -apple-system, BlinkMacSystemFont,
               "Segoe UI", sans-serif;

  font-size: 20px;
  font-weight: 600;

  line-height: 1.3;

  color: #3d3d3d;
}

.translate-modal-header p {
  margin: 0 0 20px 0;

  font-size: 13px;
  line-height: 1.6;

  color: #777;
}

/* Instruction Cards */
.translate-steps {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.step-card {
  padding: 14px 16px;

  background-color: #f8f5f0;

  border: 1px solid #e4e0db;
  border-radius: 4px;

  transition:
    background-color 0.15s ease,
    border-color 0.15s ease;
}

/* Highlight Detected Browser */
.step-card.detected {
  border-color: #325d88;
  background-color: #f1f5f9;

  order: -1;
}

.browser-badge {
  display: inline-block;

  margin-bottom: 6px;

  font-size: 13px;
  font-weight: 600;

  color: #325d88;
}

.step-card.detected .browser-badge {
  color: #325d88;
}

.step-card.detected .browser-badge::after {
  content: " (Your Browser)";

  font-size: 11px;
  font-weight: 400;

  color: #777;
}

.step-card ol {
  margin: 0;
  padding-left: 20px;

  font-size: 13px;
  line-height: 1.65;

  color: #555;
}

.step-card li + li {
  margin-top: 3px;
}

.step-card strong {
  font-weight: 600;
  color: #3d3d3d;
}
</style>

<script>
function openTranslateModal() {
  const modal = document.getElementById('translateModal');

  detectBrowser();

  modal.classList.add('is-active');
}

function closeTranslateModal(event) {
  const modal = document.getElementById('translateModal');

  modal.classList.remove('is-active');
}

// Highlight user's browser automatically
function detectBrowser() {
  const ua = navigator.userAgent;

  let targetId = '';

  if (ua.includes('Edg/')) {
    targetId = 'guide-edge';

  } else if (ua.includes('Safari') && !ua.includes('Chrome')) {
    targetId = 'guide-safari';

  } else if (ua.includes('Chrome')) {
    targetId = 'guide-chrome';
  }

  if (targetId) {
    const card = document.getElementById(targetId);

    if (card) {
      card.classList.add('detected');
    }
  }
}
</script>
