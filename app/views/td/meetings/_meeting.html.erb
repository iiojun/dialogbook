<tr>
  <td><%= meeting.name %>
    <ul>
      <li>start date:
        <% meeting.project.schools.each { |s| %>
          <div><%= meeting.start_date.in_time_zone(s.time_zone) %> @
               <%= s.time_zone %></div>
        <% } %>
      <li>memo: <%= markdown(meeting.memo, p_class: "mb-0") %></li>
      <% if meeting.teacher_only %>
        <li>visibility: 
          <span class="text-warning">
            <%= "This activity is invisible to students" %>
          </span>
        </li>
      <% end %>
    </li>
  </td>
  <td><%= link_to "edit", edit_td_meeting_path(meeting),
                  class: "btn btn-success btn-sm" %>
  </td>
  <td><%= link_to "delete", td_meeting_path(meeting), 
                  class: "btn btn-secondary btn-sm",
                  data: { turbo_confirm: "Are you sure?",
                          turbo_method: :delete }  %>
  </td>
</tr>
