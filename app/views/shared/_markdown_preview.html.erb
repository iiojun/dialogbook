<div class="modal fade"
     id="markdownPreviewModal"
     tabindex="-1"
     aria-labelledby="markdownPreviewModalLabel"
     aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title" id="markdownPreviewModalLabel">
          Preview
        </h5>
        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Close">
        </button>
      </div>
      <div class="modal-body"
           data-markdown-preview-target="preview">
      </div>
    </div>
  </div>
</div>

