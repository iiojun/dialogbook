<%= render "shared/breadcrumbs",
      items: [["My Page", root_path],
              ["Lessons", td_lessons_path],
              ["Lesson", edit_td_lesson_path(@rubric.lesson)],
              ["Question", nil]] %>

<h1>Edit a Question Item</h1>
<%= form_with model: [:td, @rubric] do |f| %>
  <table class="table table-sm table-striped">
    <tr>
      <th width="10%">Item</th>
      <th width="90%">Field</th>
    </tr>
    <tr>
      <td><%= f.label "item:" %></td>
      <td><%= f.text_area :item, style: "width:100%",
                                 class: "form-control" %></td>
    </tr>
  </table>
  <%= f.submit "update", class: "btn btn-primary" %>
<% end %>
